# Copiar a .env y configurar localmente. Nunca publicar la clave real.
GROK_API_KEY=
GROK_MODEL=grok-4.20-0309-non-reasoning
GROK_BASE_URL=https://api.reto.pltk.mx/v1
# 1 envía x-grok-conv-id para que la pasarela atienda la conversación en el mismo servidor (caché del prompt).
